RewriteEngine On

# Don't rewrite if request is for a real directory or file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Remove .php extension for simple routes
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Admin pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin-dashboard/?$ front-end/pages/admin/dashboard.php [NC,L]
RewriteRule ^create-member/?$ back-end/controllers/memberController.php?action=create [QSA,NC,L]
RewriteRule ^members-management/?$ back-end/controllers/memberController.php [NC,L]
RewriteRule ^member-management/?$ back-end/controllers/memberController.php [NC,L]